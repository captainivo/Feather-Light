#!/usr/bin/env python3
"""Secret-safe client for Granite Archive intake and exact proposal approval."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sys
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen


MODES = {"capture", "develop", "archive", "update", "retcon", "discard", "lookup", "report"}
STATUSES = {"canon", "probable", "draft", "speculative", "contradicted", "retconned", "discarded"}
REQUIRED = {
    "submission_id", "mode", "source_client", "submitted_at", "content", "requested_status",
    "targets", "categories", "metadata",
}
OPTIONAL = {"primary_subject"}


def fail(message: str) -> None:
    raise ValueError(message)


def load_request(path: str) -> dict:
    value = json.loads(Path(path).read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        fail("request must be a JSON object")
    missing = sorted(REQUIRED - value.keys())
    extra = sorted(value.keys() - REQUIRED - OPTIONAL)
    if missing:
        fail(f"missing fields: {', '.join(missing)}")
    if extra:
        fail(f"unknown fields: {', '.join(extra)}")
    if value["mode"] not in MODES:
        fail("invalid mode")
    if value["requested_status"] not in STATUSES:
        fail("invalid requested_status")
    for field in ("submission_id", "source_client", "submitted_at", "content"):
        if not isinstance(value[field], str):
            fail(f"{field} must be a string")
    for field in ("targets", "categories"):
        if not isinstance(value[field], list) or not all(isinstance(item, str) for item in value[field]):
            fail(f"{field} must be an array of strings")
    if not isinstance(value["metadata"], dict):
        fail("metadata must be an object")
    if value["mode"] in {"capture", "archive", "update", "retcon", "discard"} and not value["content"].strip():
        fail(f"{value['mode']} requires content")
    if value["mode"] in {"update", "retcon"} and not value["targets"]:
        fail(f"{value['mode']} requires at least one target")
    return value


def token() -> str:
    path = Path(os.environ.get("GRANITE_ARCHIVE_TOKEN_FILE", "~/.config/granite-archive/webhook-token")).expanduser()
    value = path.read_text(encoding="utf-8").strip()
    if not value:
        fail(f"token file is empty: {path}")
    return value


def webhook_url() -> str:
    configured = os.environ.get("GRANITE_ARCHIVE_WEBHOOK_URL", "").strip()
    if configured:
        return configured
    path = Path(os.environ.get("GRANITE_ARCHIVE_WEBHOOK_URL_FILE", "~/.config/granite-archive/webhook-url")).expanduser()
    value = path.read_text(encoding="utf-8").strip()
    if not value:
        fail(f"webhook URL file is empty: {path}")
    return value


def proposal_url() -> str:
    configured = os.environ.get("GRANITE_ARCHIVE_PROPOSAL_URL", "").strip()
    if configured:
        return configured
    intake = webhook_url()
    if not intake.endswith("/story-archive/intake"):
        fail("set GRANITE_ARCHIVE_PROPOSAL_URL when the intake URL is non-standard")
    return intake.removesuffix("/story-archive/intake") + "/story-archive/proposal"


def submit(value: dict) -> dict:
    endpoint = webhook_url()
    request = Request(
        endpoint,
        data=json.dumps(value, separators=(",", ":")).encode("utf-8"),
        method="POST",
        headers={
            "Content-Type": "application/json",
            "X-Granite-Archive-Key": token(),
            "User-Agent": "granite-archive/0.1.0",
        },
    )
    try:
        with urlopen(request, timeout=30) as response:
            body = response.read().decode("utf-8")
            result = json.loads(body)
            if not isinstance(result, dict):
                fail("intake returned a non-object JSON response")
            return result
    except HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")[:2000]
        fail(f"intake HTTP {error.code}: {body}")
    except URLError as error:
        fail(f"intake unavailable: {error.reason}")


def proposal_action(value: dict) -> dict:
    request = Request(
        proposal_url(),
        data=json.dumps(value, separators=(",", ":")).encode("utf-8"),
        method="POST",
        headers={
            "Content-Type": "application/json",
            "X-Granite-Archive-Key": token(),
            "User-Agent": "granite-archive/0.2.0",
        },
    )
    try:
        with urlopen(request, timeout=30) as response:
            result = json.loads(response.read().decode("utf-8"))
            if not isinstance(result, dict):
                fail("proposal endpoint returned a non-object JSON response")
            return result
    except HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")[:2000]
        fail(f"proposal HTTP {error.code}: {body}")
    except URLError as error:
        fail(f"proposal endpoint unavailable: {error.reason}")


def main() -> int:
    parser = argparse.ArgumentParser(prog="archivectl")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("validate", "submit"):
        request_parser = subparsers.add_parser(command)
        request_parser.add_argument("request_file")
    review_parser = subparsers.add_parser("review")
    review_parser.add_argument("transaction_id")
    approve_parser = subparsers.add_parser("approve")
    approve_parser.add_argument("transaction_id")
    approve_parser.add_argument("proposal_hash")
    approve_parser.add_argument("--approved-by", default="captain-ivo")
    args = parser.parse_args()
    try:
        if args.command in {"validate", "submit"}:
            value = load_request(args.request_file)
            result = {"status": "locally_valid", "persisted": False, "submission_id": value["submission_id"]} \
                if args.command == "validate" else submit(value)
        elif args.command == "review":
            result = proposal_action({"action": "review", "transaction_id": args.transaction_id})
        else:
            if len(args.proposal_hash) != 64 or any(character not in "0123456789abcdef" for character in args.proposal_hash):
                fail("proposal_hash must be 64 lowercase hexadecimal characters")
            result = proposal_action({
                "action": "approve", "transaction_id": args.transaction_id,
                "proposal_hash": args.proposal_hash, "approved_by": args.approved_by,
            })
        print(json.dumps(result, ensure_ascii=False))
        return 0
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(json.dumps({"status": "error", "error": str(error)}), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
