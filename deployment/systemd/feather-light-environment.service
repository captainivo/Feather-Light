[Unit]
Description=Advance Feather-Light's TypeScript Aauthora environment
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mithra/feather-light
Environment=NODE_ENV=production
Environment=FEATHER_LIGHT_CONFIG=/home/mithra/.config/feather-light/config.yaml
Environment=PATH=/home/mithra/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node /home/mithra/feather-light/dist/src/cli.js environment catch-up
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/mithra/.hermes/mithra/feather-light/state
