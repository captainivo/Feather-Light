{
  "name": "Story Archive - Completion Email",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "5ee6309b-1ae5-4c78-8494-848d5b47be2b",
      "name": "Receive Completed Transaction",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [-420, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a31a6265-b11f-41ff-98de-a5bc1798a43c",
              "leftValue": "={{ $json.transaction_status }}",
              "rightValue": "succeeded",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "496fdb0f-95da-4acc-8988-e7f1a72885c1",
              "leftValue": "={{ $json.note_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "40f92d2a-d5de-45aa-86b8-e3ee3b70c944",
              "leftValue": "={{ $json.git_revision }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e1c365b4-05ca-450c-a3ed-e55f767c2d15",
      "name": "Verified Archive Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-180, 0]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.ARCHIVE_NOTIFICATION_FROM }}",
        "toEmail": "={{ $env.ARCHIVE_NOTIFICATION_EMAIL }}",
        "subject": "={{ '[Westpole Archive] ' + ($json.note_title ?? $json.note_id) + ' added' }}",
        "emailFormat": "text",
        "text": "={{ 'A note was successfully added to the private Westpole archive.\\n\\nTitle: ' + ($json.note_title ?? 'Untitled') + '\\nPermanent ID: ' + $json.note_id + '\\nOperation: ' + ($json.mode ?? 'archive') + '\\nCanon status: ' + ($json.canon_status ?? 'unknown') + '\\nChanged file: ' + ($json.relative_path ?? 'not reported') + '\\nGit revision: ' + $json.git_revision + '\\nTransaction: ' + ($json.transaction_id ?? 'not reported') + '\\nCompleted: ' + ($json.completed_at ?? 'not reported') + '\\n\\nThis message contains procedural details only; private story content is not included.' }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "b0e046d7-300e-4101-a673-f0d06ead2c1d",
      "name": "Email Archive Receipt",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [80, -80],
      "credentials": {
        "smtp": {
          "id": "granite-archive-notifications",
          "name": "Granite Archive Notifications"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "Completion email rejected: transaction is not succeeded or lacks its committed note ID/Git revision."
      },
      "id": "4c559788-37de-4661-8ed9-b45984f59943",
      "name": "Reject Premature Notification",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [80, 100]
    }
  ],
  "pinData": {},
  "connections": {
    "Receive Completed Transaction": {
      "main": [[{"node": "Verified Archive Success?", "type": "main", "index": 0}]]
    },
    "Verified Archive Success?": {
      "main": [
        [{"node": "Email Archive Receipt", "type": "main", "index": 0}],
        [{"node": "Reject Premature Notification", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "b7888964-a6f3-46b8-86ce-c078869da093",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
