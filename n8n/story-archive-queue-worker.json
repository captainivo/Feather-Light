      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FEATHER_LIGHT_BASE_URL + '/v1/archive/transactions/claim' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FEATHER_LIGHT_API_TOKEN }}" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workerId: $env.FEATHER_LIGHT_WORKER_ID, occurredAt: $now.toISO() }) }}",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "id": "206b75e5-64f4-46ee-b9f7-f1a219792bd7",
      "name": "Claim Next Transaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-360, 0]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [
        { "id": "6ed27322-f85a-44db-8636-5c01b4bbfe5f", "leftValue": "={{ $json.statusCode }}", "rightValue": 200, "operator": { "type": "number", "operation": "equals" } }
      ], "combinator": "and" } },
      "id": "bd5ef4d2-cdd0-48a5-ab31-c4a00ac8db16",
