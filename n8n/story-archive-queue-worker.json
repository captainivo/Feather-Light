{
  "name": "Story Archive - Queue Worker",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] } },
      "id": "8e106108-0c75-410b-94ce-6ad33fe94b02",
