        "queryParameters": { "parameters": [{ "name": "worker_id", "value": "={{ $env.FEATHER_LIGHT_WORKER_ID }}" }] },
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "={{ 'Bearer ' + $env.FEATHER_LIGHT_API_TOKEN }}" }] },
        "options": {}
      },
      "id": "c9248bc1-f6c4-4520-926a-cfe8cf689ff6",
      "name": "Fetch Claimed Work",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [120, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FEATHER_LIGHT_BASE_URL + '/v1/archive/validate' }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FEATHER_LIGHT_API_TOKEN }}" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": { "response": { "response": { "fullResponse": true, "neverError": true } } }
      },
      "id": "49850ec3-00b3-45ec-bb9b-daed82f77bf3",
      "name": "Validate Claimed Submission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, -100]
    },
    {
      "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [
        { "id": "805c0dbc-6d82-4311-9884-596d7f11e88a", "leftValue": "={{ $json.statusCode }}", "rightValue": 200, "operator": { "type": "number", "operation": "equals" } }
      ], "combinator": "and" } },
      "id": "0ee0204a-f5cc-4507-9b8e-e1e697875229",
      "name": "Submission Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, -100]
    },
    {
      "parameters": { "assignments": { "assignments": [
        { "id": "60814373-095f-4cdf-81eb-77f5557c1e3a", "name": "handoff_status", "value": "ready_for_processing", "type": "string" }
      ] }, "options": {} },
      "id": "bcddc8ca-f3fd-4f84-8969-f3480cc8e772",
      "name": "Ready For Processing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [840, -180]
