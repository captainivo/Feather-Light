    {
      "parameters": { "assignments": { "assignments": [
        { "id": "8fd1f7df-dd10-4dfd-9cd6-1c75223cae67", "name": "queue_status", "value": "empty", "type": "string" }
      ] }, "options": {} },
      "id": "2e9da65b-14f1-405b-99ee-c0ef89b67ef7",
      "name": "No Pending Work",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [120, 120]
    }
  ],
  "pinData": {},
