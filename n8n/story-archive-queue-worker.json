    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.FEATHER_LIGHT_BASE_URL + '/v1/archive/transactions/' + $('Claim Next Transaction').item.json.body.transaction.transactionId }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "Authorization", "value": "={{ 'Bearer ' + $env.FEATHER_LIGHT_API_TOKEN }}" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'failed', occurredAt: $now.toISO(), errorSummary: 'Submission failed deterministic validation at the processing boundary.' }) }}",
        "options": {}
      },
      "id": "124f05e8-b1c9-464e-bff1-d9dcdce77048",
      "name": "Mark Validation Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 20]
